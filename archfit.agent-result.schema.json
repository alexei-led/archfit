{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alexei-led/archfit/main/archfit.agent-result.schema.json",
  "$defs": {
    "Attention": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unmeasured_ratchet",
            "dead_selector",
            "existing_violation",
            "coupling_gate",
            "blocked_without_finding"
          ]
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "count": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "reason"
      ]
    },
    "Change": {
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "reason_detail": {
          "type": "string"
        },
        "policy_change": {
          "$ref": "#/$defs/PolicyChange"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/Repair"
          },
          "type": "array"
        },
        "evidence_gaps": {
          "items": {
            "$ref": "#/$defs/EvidenceGap"
          },
          "type": "array"
        },
        "unevaluated_rules": {
          "items": {
            "$ref": "#/$defs/UnevaluatedRule"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "blockers",
        "evidence_gaps",
        "unevaluated_rules"
      ]
    },
    "Edge": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to",
        "kind"
      ]
    },
    "EvidenceGap": {
      "properties": {
        "tool": {
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "install_cmd": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tool",
        "gate"
      ]
    },
    "Location": {
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "line"
      ]
    },
    "Omitted": {
      "properties": {
        "blockers": {
          "type": "integer"
        },
        "unevaluated_rules": {
          "type": "integer"
        },
        "attention": {
          "type": "integer"
        },
        "advisories": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "blockers",
        "unevaluated_rules",
        "attention",
        "advisories"
      ]
    },
    "PolicyChange": {
      "properties": {
        "files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "under_target_policy": {
          "$ref": "#/$defs/PolicyView"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "files",
        "under_target_policy"
      ]
    },
    "PolicyRef": {
      "properties": {
        "ref": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ref",
        "sha"
      ]
    },
    "PolicyView": {
      "properties": {
        "status": {
          "type": "string"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/Repair"
          },
          "type": "array"
        },
        "blockers_omitted": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "blockers"
      ]
    },
    "Repair": {
      "properties": {
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repair_kind": {
          "type": "string",
          "enum": [
            "code_change",
            "needs_owner_decision"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "introduced",
            "pre_existing",
            "unknown"
          ]
        },
        "in_scope": {
          "type": "boolean"
        },
        "severity": {
          "type": "string"
        },
        "edge": {
          "$ref": "#/$defs/Edge"
        },
        "at": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "goal": {
          "type": "string"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edit": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "at_omitted": {
          "type": "integer"
        },
        "edit_omitted": {
          "type": "integer"
        },
        "constraints_omitted": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "finding_ids",
        "rule_ids",
        "repair_kind",
        "in_scope",
        "severity",
        "at",
        "goal",
        "constraints",
        "edit"
      ]
    },
    "Repository": {
      "properties": {
        "attention": {
          "items": {
            "$ref": "#/$defs/Attention"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "attention"
      ]
    },
    "ResultIdentity": {
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "archfit.result-identity.v1"
          ]
        },
        "policy_digest": {
          "type": "string"
        },
        "baseline_digest": {
          "type": "string"
        },
        "labels_digest": {
          "type": "string"
        },
        "policy_ref": {
          "$ref": "#/$defs/PolicyRef"
        },
        "base_sha": {
          "type": "string"
        },
        "head_tree_digest": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "measurement_profile_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "engine_version"
      ]
    },
    "ScopeInfo": {
      "properties": {
        "mode": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "target_sha": {
          "type": "string"
        },
        "base": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "mode"
      ]
    },
    "UnevaluatedRule": {
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rule_id",
        "reason"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "archfit.agent-result.v1"
      ],
      "description": "The only agent-result contract this binary emits."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "healthy",
        "needs_attention",
        "blocked"
      ]
    },
    "next_action": {
      "type": "string",
      "enum": [
        "repair",
        "ask_owner",
        "restore_evidence",
        "none"
      ]
    },
    "summary": {
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/ResultIdentity"
    },
    "scope": {
      "$ref": "#/$defs/ScopeInfo"
    },
    "change": {
      "$ref": "#/$defs/Change"
    },
    "repository": {
      "$ref": "#/$defs/Repository"
    },
    "omitted": {
      "$ref": "#/$defs/Omitted"
    },
    "truncated": {
      "type": "boolean"
    },
    "validate": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "next_action",
    "summary",
    "identity",
    "change",
    "repository",
    "omitted"
  ]
}
