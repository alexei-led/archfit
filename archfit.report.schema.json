{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alexei-led/archfit/main/archfit.report.schema.json",
  "$defs": {
    "AllowedDependency": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "balance": {
          "$ref": "#/$defs/RepositoryBalance"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to",
        "balance"
      ]
    },
    "ConnascenceReport": {
      "properties": {
        "edges_with_evidence": {
          "type": "integer"
        },
        "abstained_edges": {
          "type": "integer"
        },
        "total_evidence": {
          "type": "integer"
        },
        "by_kind": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "by_source": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "unmeasured": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roadmap": {
          "items": {
            "$ref": "#/$defs/ConnascenceRoadmapItem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "edges_with_evidence",
        "abstained_edges",
        "total_evidence"
      ]
    },
    "ConnascenceRoadmapItem": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "current_status": {
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "related_signals": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "upgrade_trigger": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "current_status"
      ]
    },
    "DimensionCoverage": {
      "properties": {
        "basis": {
          "type": "string"
        },
        "observed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "basis",
        "observed",
        "total"
      ]
    },
    "DimensionState": {
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "measured",
            "partial",
            "unmeasured"
          ]
        },
        "confidence": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/DimensionCoverage"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricValue"
          },
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/FindingRef"
          },
          "type": "array"
        },
        "unknown": {
          "items": {
            "$ref": "#/$defs/UnknownFact"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "owner",
        "status",
        "confidence",
        "coverage",
        "metrics",
        "findings",
        "unknown"
      ]
    },
    "Dimensions": {
      "properties": {
        "intent": {
          "$ref": "#/$defs/DimensionState"
        },
        "structure": {
          "$ref": "#/$defs/DimensionState"
        },
        "modularity": {
          "$ref": "#/$defs/DimensionState"
        },
        "coupling": {
          "$ref": "#/$defs/DimensionState"
        },
        "change_locality": {
          "$ref": "#/$defs/DimensionState"
        },
        "complexity": {
          "$ref": "#/$defs/DimensionState"
        },
        "testability": {
          "$ref": "#/$defs/DimensionState"
        },
        "operations": {
          "$ref": "#/$defs/DimensionState"
        },
        "drift": {
          "$ref": "#/$defs/DimensionState"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "intent",
        "structure",
        "modularity",
        "coupling",
        "change_locality",
        "complexity",
        "testability",
        "operations",
        "drift"
      ]
    },
    "EvidenceComponent": {
      "properties": {
        "name": {
          "type": "string"
        },
        "declared": {
          "type": "boolean"
        },
        "public": {
          "$ref": "#/$defs/EvidencePathsFact"
        },
        "subdomain": {
          "$ref": "#/$defs/EvidenceStringFact"
        },
        "volatility": {
          "$ref": "#/$defs/EvidenceStringFact"
        },
        "unknowns": {
          "items": {
            "$ref": "#/$defs/UnknownFact"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "declared",
        "public",
        "subdomain",
        "volatility",
        "unknowns"
      ]
    },
    "EvidenceConnascence": {
      "properties": {
        "population": {
          "type": "string",
          "enum": [
            "all_set_edges"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "edge"
          ]
        },
        "total_edges": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "oneOf": [
            {
              "$ref": "#/$defs/ConnascenceReport"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "population",
        "unit",
        "total_edges",
        "summary"
      ]
    },
    "EvidenceConnascenceItem": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "source",
        "detail"
      ]
    },
    "EvidenceLanguage": {
      "properties": {
        "name": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "auto"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "mode"
      ]
    },
    "EvidenceObservation": {
      "properties": {
        "from_node": {
          "type": "string"
        },
        "to_node": {
          "type": "string"
        },
        "edge_kind": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "connascence": {
          "items": {
            "$ref": "#/$defs/EvidenceConnascenceItem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from_node",
        "to_node",
        "edge_kind",
        "language",
        "sites",
        "connascence"
      ]
    },
    "EvidencePair": {
      "properties": {
        "pair_id": {
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/EvidenceObservation"
          },
          "type": "array"
        },
        "interface_inventory": {
          "$ref": "#/$defs/InterfaceInventory"
        },
        "unknowns": {
          "items": {
            "$ref": "#/$defs/UnknownFact"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "pair_id",
        "observations",
        "interface_inventory",
        "unknowns"
      ]
    },
    "EvidencePathsFact": {
      "properties": {
        "raw": {
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective": {
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "observed",
            "asserted",
            "assessed",
            "assumed",
            "unknown"
          ]
        },
        "derivation": {
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "raw",
        "effective",
        "origin",
        "derivation",
        "refs"
      ]
    },
    "EvidencePopulation": {
      "properties": {
        "population": {
          "type": "string",
          "enum": [
            "seam_eligible_set_edges"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "edge"
          ]
        },
        "total_edges": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "population",
        "unit",
        "total_edges"
      ]
    },
    "EvidenceRef": {
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "selector": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "captured",
            "changed",
            "unknown"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "sha256",
        "status"
      ]
    },
    "EvidenceScope": {
      "properties": {
        "abstraction": {
          "type": "string",
          "enum": [
            "module"
          ]
        },
        "source_root": {
          "type": "string"
        },
        "policy_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "module_inventory_hash": {
          "type": "string"
        },
        "classification_hash": {
          "type": "string"
        },
        "exclude": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "generated": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "languages": {
          "items": {
            "$ref": "#/$defs/EvidenceLanguage"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "abstraction",
        "source_root",
        "policy_ref",
        "module_inventory_hash",
        "classification_hash",
        "exclude",
        "tests",
        "generated",
        "languages"
      ]
    },
    "EvidenceSnapshot": {
      "properties": {
        "head_commit": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "head_tree": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_digest": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_digest": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_before_digest": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_after_digest": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanliness": {
          "type": "string",
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        },
        "stability": {
          "type": "string",
          "enum": [
            "stable_by_pre_post_check",
            "changed",
            "unknown"
          ]
        },
        "policy_binding": {
          "type": "string",
          "enum": [
            "match",
            "mismatch",
            "unknown"
          ]
        },
        "unknowns": {
          "items": {
            "$ref": "#/$defs/UnknownFact"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "head_commit",
        "head_tree",
        "before_digest",
        "after_digest",
        "policy_before_digest",
        "policy_after_digest",
        "cleanliness",
        "stability",
        "policy_binding",
        "unknowns"
      ]
    },
    "EvidenceStringFact": {
      "properties": {
        "raw": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "observed",
            "asserted",
            "assessed",
            "assumed",
            "unknown"
          ]
        },
        "derivation": {
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "raw",
        "effective",
        "origin",
        "derivation",
        "refs"
      ]
    },
    "ExpiringException": {
      "properties": {
        "rule": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "expires": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "rule",
        "from",
        "expires"
      ]
    },
    "Finding": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        },
        "edge": {
          "$ref": "#/$defs/FindingEdge"
        },
        "matched_by": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "why": {
          "type": "string"
        },
        "constraint": {
          "type": "string"
        },
        "allowed_alternatives": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "kind",
        "rule_id",
        "status",
        "severity",
        "confidence",
        "edge",
        "matched_by",
        "locations",
        "why",
        "constraint"
      ]
    },
    "FindingEdge": {
      "properties": {
        "from": {
          "$ref": "#/$defs/FindingEndpoint"
        },
        "to": {
          "$ref": "#/$defs/FindingEndpoint"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "from",
        "to",
        "kind"
      ]
    },
    "FindingEndpoint": {
      "properties": {
        "module": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "module",
        "path"
      ]
    },
    "FindingRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "rule_id",
        "kind",
        "severity",
        "status"
      ]
    },
    "InterfaceInventory": {
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "reason"
      ]
    },
    "Location": {
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "file",
        "line"
      ]
    },
    "MetricDenominator": {
      "properties": {
        "observed": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "observed",
        "total"
      ]
    },
    "MetricValue": {
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "denominator": {
          "$ref": "#/$defs/MetricDenominator"
        },
        "provenance": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "value",
        "unit"
      ]
    },
    "NoteRule": {
      "properties": {
        "id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "note"
      ]
    },
    "PolicyRef": {
      "properties": {
        "ref": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ref",
        "sha"
      ]
    },
    "ReportEvidence": {
      "properties": {
        "scope": {
          "$ref": "#/$defs/EvidenceScope"
        },
        "snapshot": {
          "$ref": "#/$defs/EvidenceSnapshot"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/EvidenceComponent"
          },
          "type": "array"
        },
        "pair_population": {
          "$ref": "#/$defs/EvidencePopulation"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/EvidencePair"
          },
          "type": "array"
        },
        "connascence": {
          "$ref": "#/$defs/EvidenceConnascence"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "scope",
        "snapshot",
        "components",
        "pair_population",
        "pairs",
        "connascence"
      ]
    },
    "RepositoryBalance": {
      "properties": {
        "value": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "value",
        "min"
      ]
    },
    "RepositoryError": {
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "rule": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "instead": {
          "type": "string"
        },
        "balance": {
          "$ref": "#/$defs/RepositoryBalance"
        },
        "expires": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "rule",
        "what"
      ]
    },
    "RepositoryState": {
      "properties": {
        "state": {
          "type": "string"
        },
        "drift": {
          "items": {
            "$ref": "#/$defs/RepositoryError"
          },
          "type": "array"
        },
        "expired": {
          "items": {
            "$ref": "#/$defs/RepositoryError"
          },
          "type": "array"
        },
        "expiring": {
          "items": {
            "$ref": "#/$defs/ExpiringException"
          },
          "type": "array"
        },
        "not_checked": {
          "items": {
            "$ref": "#/$defs/NoteRule"
          },
          "type": "array"
        },
        "balances": {
          "items": {
            "$ref": "#/$defs/AllowedDependency"
          },
          "type": "array"
        },
        "unread": {
          "items": {
            "$ref": "#/$defs/UnreadPlace"
          },
          "type": "array"
        },
        "protected": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "state",
        "drift",
        "expired",
        "expiring",
        "not_checked",
        "balances",
        "unread",
        "protected"
      ]
    },
    "ResultIdentity": {
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "archfit.result-identity.v1"
          ]
