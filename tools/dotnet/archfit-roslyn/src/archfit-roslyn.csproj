<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>archfit-roslyn</AssemblyName>
    <RootNamespace>ArchfitRoslyn</RootNamespace>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SelfContained>false</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RoslynVersion>5.6.0</RoslynVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="archfit-roslyn.Tests" />
    <!-- The producer identity (option version) names the package version, not the assembly's build number. -->
    <AssemblyMetadata Include="RoslynVersion" Value="$(RoslynVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBuildLocator loads MSBuild from the installed SDK; shipping this assembly breaks it (MSBL001). -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
  </ItemGroup>
</Project>
